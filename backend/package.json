{
  "name": "nexora-backend",
  "version": "1.0.0",
  "description": "Back-end del catálogo de dispositivos inteligentes Nexora. Arquitectura por capas (routes -> controllers -> services -> repositories) sobre Express y SQLite.",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/database/seed.js",
    "backup": "node src/database/backup.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  }
}
